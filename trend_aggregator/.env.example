# 复制为 .env.local 并填入真实值（.env.local 不会被 Git 跟踪）
#
# GitHub Fine-grained Token（只读公开仓库即可）
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# 大模型 — DeepSeek（OpenAI 兼容接口，默认）
TREND_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 备选：OpenAI
# TREND_LLM_PROVIDER=openai
# OPENAI_API_KEY=
