# Mac 端：今日抽查完成后延时禁用老师账号（每 15 分钟）
# 复制到 ~/.config/info-quests/teacher-user-quiz-complete-disable.env
#
# 安装 launchd：
#   bash scripts/setup-teacher-user-quiz-complete-disable-mac.sh
#
# 试跑（不写库）：
#   python3 scripts/teacher-user-quiz-complete-disable-api.py --dry-run
#
# Bearer Token 使用 jp-review-sync.env 里的 JP_REVIEW_UPLOAD_TOKEN
TEACHER_USER_QUIZ_COMPLETE_DISABLE_URL=https://finance.info-quests.com/api/admin/teacher-user-quiz-complete-disable
TEACHER_USER_QUIZ_COMPLETE_DISABLE_PYTHON=python3
