# Mac 端英语单词 IPA 音标 nightly 补全（复制到 ~/.config/info-quests/en-vocab-fill-reading.env）
#
# 安装定时任务：
#   bash scripts/setup-en-vocab-fill-reading-mac.sh
#
# 手动试跑（不写库）：
#   python3 scripts/migrate-en-vocab-fill-reading.py --remote --dry-run
#
# 目标库：remote=线上 D1（默认），local=本机 wrangler 本地 D1
EN_VOCAB_FILL_READING_TARGET=remote
# 词典 API 请求间隔（秒），避免限流
EN_VOCAB_FILL_READING_DICT_DELAY=0.25
# launchd 每天执行时间（24 小时制，默认 22:30，与日语任务错开）
EN_VOCAB_FILL_READING_HOUR=22
EN_VOCAB_FILL_READING_MINUTE=30
