# 日语新课板书 Word（含 OJAD 读音）
# 复制到 ~/.config/info-quests/jp-lesson-board-docx.env

# 可选：覆盖 API（默认走 finance 同 Worker）
# JP_LESSON_BOARD_DOCX_API_URL=https://finance.info-quests.com/api/jp-lesson/board-docx

# 每轮最多处理几课
JP_LESSON_BOARD_DOCX_LIMIT=2

# launchd 间隔（秒）；setup 读取
JP_LESSON_BOARD_DOCX_INTERVAL_SECONDS=60

# 锁过期（秒）
JP_LESSON_BOARD_DOCX_LOCK_STALE_SECONDS=900
