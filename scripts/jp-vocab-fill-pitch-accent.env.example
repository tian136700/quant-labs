# OJAD 音调补全（~/.config/info-quests/jp-vocab-fill-pitch-accent.env）
# Bearer Token 默认读 jp-review-sync.env 里的 JP_REVIEW_UPLOAD_TOKEN

# JP_VOCAB_FILL_PITCH_ACCENT_URL=https://finance.info-quests.com/api/jp-vocab/fill-pitch-accent
# 每轮最多处理几条（默认 3）
JP_VOCAB_FILL_PITCH_ACCENT_BATCH=3
# OJAD 请求间隔秒（礼貌限速，默认 5）
JP_VOCAB_FILL_PITCH_ACCENT_OJAD_GAP=5
# launchd StartInterval（setup 脚本用，默认 60）
JP_VOCAB_FILL_PITCH_ACCENT_INTERVAL_SECONDS=60
