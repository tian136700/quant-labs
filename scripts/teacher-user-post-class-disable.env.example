# Mac 端：下课 10 分钟后自动禁用老师账号（每 10 分钟）
# 复制到 ~/.config/info-quests/teacher-user-post-class-disable.env
#
# 安装 launchd：
#   bash scripts/setup-teacher-user-post-class-disable-mac.sh
#
# 试跑（不写库）：
#   python3 scripts/teacher-user-post-class-disable-api.py --dry-run
#
# Bearer Token 使用 jp-review-sync.env 里的 JP_REVIEW_UPLOAD_TOKEN
TEACHER_USER_POST_CLASS_DISABLE_URL=https://finance.info-quests.com/api/admin/teacher-user-post-class-disable
TEACHER_USER_POST_CLASS_DISABLE_PYTHON=python3
# 目录锁过期秒数（默认 600=10 分钟，与调度间隔一致；防止上一轮卡住永久 skip）
# TEACHER_USER_POST_CLASS_DISABLE_LOCK_STALE_SECONDS=600
