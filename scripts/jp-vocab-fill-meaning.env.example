# 日语释义补全（tokken Anthropic 限流；无 launchd）
# 密钥与英语共用：~/.config/info-quests/en-vocab-fill.env 或 anthropic.env

# 线上 Worker API
# JP_VOCAB_FILL_MEANING_URL=https://finance.info-quests.com/api/jp-vocab/fill-meaning

# 两轮付费调用最小间隔（秒）；默认 60。禁止改成很小。
JP_VOCAB_FILL_MEANING_MIN_INTERVAL_SEC=60

# 校验/调用失败词冷却（秒）；默认 6h
JP_VOCAB_FILL_MEANING_POISON_SEC=21600
