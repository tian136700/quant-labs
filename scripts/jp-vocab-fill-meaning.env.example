# 日语单词释义补全（Mac / 其它项目定时）
# Token：~/.config/info-quests/jp-review-sync.env → JP_REVIEW_UPLOAD_TOKEN
#
# POST https://finance.info-quests.com/api/jp-vocab/fill-meaning
#   1) 拉取：{"mode":"list_missing","limit":15}
#   2) 写回：{"mode":"apply","source":"Qwen本地","updates":[{"word_id":1,"meaning":"休息；假期"}]}
# 多义用中文分号「；」，最多 3 个常用义；source 显示为「释义来源」

# JP_VOCAB_FILL_MEANING_URL=https://finance.info-quests.com/api/jp-vocab/fill-meaning
JP_VOCAB_FILL_MEANING_LIMIT=15
