# Mac 端英语词条补全（音标 / 释义 / 词性 / 用法 / 例句 —— 五个独立 launchd 任务）
# 顺序硬依赖：reading → meaning → pos → usage → examples（例句须先有 usage）
# 复制到：~/.config/info-quests/en-vocab-fill.env
#
# 安装（每阶段独立占/放 ollama_slot）：
#   bash scripts/setup-en-vocab-fill-mac.sh
#
# 手动单阶段：
#   FORCE=1 bash scripts/en-vocab-fill-stage.sh reading
#   FORCE=1 bash scripts/en-vocab-fill-stage.sh meaning
#   FORCE=1 bash scripts/en-vocab-fill-stage.sh pos
#   FORCE=1 bash scripts/en-vocab-fill-stage.sh usage
#   FORCE=1 bash scripts/en-vocab-fill-stage.sh examples
#
# 按用法重造例句前可清空：
#   python3 scripts/en-vocab-clear-example-sentences.py --dry-run
#   python3 scripts/en-vocab-clear-example-sentences.py
#
# Token 共用日语教案上传：
#   ~/.config/info-quests/jp-review-sync.env → JP_REVIEW_UPLOAD_TOKEN

# 本机 Ollama（见 /Users/Admin/.config/local-llm/howto.md）
# 链：谷歌 gemma → 阿里 14b → 阿里 7b；单模型墙钟 10 分钟超时后切档
EN_VOCAB_FILL_OLLAMA_MODEL=gemma4:26b
EN_VOCAB_FILL_OLLAMA_FALLBACK_MODEL=qwen2.5:14b,qwen2.5:7b
EN_VOCAB_FILL_OLLAMA_URL=http://127.0.0.1:11434/api/chat
EN_VOCAB_FILL_OLLAMA_TIMEOUT_SEC=600

# 每阶段每轮条数上限（例句/用法必须 1：单词可能吃满 600s×3 档，一批多条会跑近小时）
EN_VOCAB_FILL_READING_LIMIT=10
EN_VOCAB_FILL_MEANING_LIMIT=8
EN_VOCAB_FILL_USAGE_LIMIT=1
EN_VOCAB_FILL_EXAMPLE_LIMIT=1

# launchd 间隔（秒）：每分钟检测；槽被占则 skip，不必 10 分钟才醒
EN_VOCAB_FILL_INTERVAL_SECONDS=60
# 槽忙时等待秒数：0=立刻 skip（配合每分钟检测）
EN_VOCAB_FILL_OLLAMA_SLOT_WAIT_SEC=0

# 可选静默（北京时间）；默认 24–24 = 不静默
EN_VOCAB_FILL_QUIET_START_HOUR=24
EN_VOCAB_FILL_QUIET_END_HOUR=24
