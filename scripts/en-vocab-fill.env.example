# Mac 端英语词条补全（音标 / 释义+词性 / 例句）
# 复制到：~/.config/info-quests/en-vocab-fill.env
#
# 安装（每 10 分钟，dirlock 防重叠）：
#   bash scripts/setup-en-vocab-fill-mac.sh
#
# 手动试跑：
#   python3 scripts/en-vocab-fill-reading-api.py --dry-run
#   python3 scripts/en-vocab-fill-meaning-api.py --dry-run
#   python3 scripts/en-vocab-fill-example-sentences-api.py --dry-run
#   FORCE=1 bash scripts/en-vocab-fill-nightly.sh
#
# Token 共用日语教案上传：
#   ~/.config/info-quests/jp-review-sync.env → JP_REVIEW_UPLOAD_TOKEN

# 本机 Ollama（见 /Users/Admin/.config/local-llm/howto.md）
# 质量优先用谷歌 gemma4:26b；轻量可改 qwen2.5:7b
EN_VOCAB_FILL_OLLAMA_MODEL=gemma4:26b
EN_VOCAB_FILL_OLLAMA_URL=http://127.0.0.1:11434/api/chat
EN_VOCAB_FILL_OLLAMA_TIMEOUT_SEC=360

# 每轮条数上限（gemma4:26b 较慢，别一次拉太多）
EN_VOCAB_FILL_READING_LIMIT=15
EN_VOCAB_FILL_MEANING_LIMIT=10
EN_VOCAB_FILL_EXAMPLE_LIMIT=6

# 分段开关
EN_VOCAB_FILL_DO_READING=1
EN_VOCAB_FILL_DO_MEANING=1
EN_VOCAB_FILL_DO_EXAMPLES=1

# launchd 间隔（秒）
EN_VOCAB_FILL_INTERVAL_SECONDS=600

# 可选静默（北京时间）；默认 24–24 = 不静默
EN_VOCAB_FILL_QUIET_START_HOUR=24
EN_VOCAB_FILL_QUIET_END_HOUR=24

# API（一般不用改）
# EN_VOCAB_FILL_READING_URL=https://finance.info-quests.com/api/en-vocab/fill-reading
# EN_VOCAB_FILL_MEANING_URL=https://finance.info-quests.com/api/en-vocab/fill-meaning
# EN_VOCAB_FILL_EXAMPLE_SENTENCES_URL=https://finance.info-quests.com/api/en-vocab/fill-example-sentences
