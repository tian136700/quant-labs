# Mac：统一日程开课前 Bark（已改线上 Cron，本机默认关闭防双推）
# 复制到 ~/.config/info-quests/schedule-class-bark-remind.env
#
# 线上（推荐，Mac 关机也能推）：
#   Cloudflare Cron → POST /api/admin/schedule-class-bark-remind
#   需：npx wrangler secret put BARK_DEVICE_KEY
#
# 本机备用（仅当线上 Cron 不可用时再开）：
#   bash scripts/setup-schedule-class-bark-remind-mac.sh
#   并把下面 ENABLED 改成 1
#
# 试跑（本机脚本，不推送）:
#   python3 scripts/schedule-class-bark-remind.py --dry-run --list-upcoming 24
#
# Bearer Token 复用 jp-review-sync.env 里的 JP_REVIEW_UPLOAD_TOKEN
# Bark key 默认读仓库 .env.deploy.local；也可在此覆盖：
# BARK_DEVICE_KEY=

SCHEDULE_CLASS_BARK_REMIND_URL=https://finance.info-quests.com/api/admin/schedule-events
# 开课前三档持续铃响（北京时间课表触发；通知展示泰国时间 = 北京 − 1h）
SCHEDULE_CLASS_BARK_LEAD_MINUTES=10,5,1
# 上云后务必保持 0，否则会与 Worker Cron 双推
SCHEDULE_CLASS_BARK_REMIND_ENABLED=0
SCHEDULE_CLASS_BARK_REMIND_PYTHON=python3
