# 日语单词/语法例句补全（Mac / 其它项目定时脚本）
# Token 与 jp-review-sync 共用：~/.config/info-quests/jp-review-sync.env → JP_REVIEW_UPLOAD_TOKEN
#
# 接口：POST https://finance.info-quests.com/api/jp-vocab/fill-example-sentences
#   1) 拉取缺例句：{"mode":"list_missing","limit":15}
#   2) 写回例句：{"mode":"apply","updates":[{"word_id":123,"example_sentences":"..."}]}
# 写回会强制校验格式（见响应里的 upload_spec / 规则 jp-vocab-example-sentences-compose.mdc）

# JP_VOCAB_FILL_EXAMPLE_SENTENCES_URL=https://finance.info-quests.com/api/jp-vocab/fill-example-sentences
# 每次最多拉几条缺例句（建议 10～30，避免一次跑太久）
JP_VOCAB_FILL_EXAMPLE_AI_LIMIT=15
