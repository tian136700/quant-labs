# 日语单词例句 AI 补全（Mac 脚本 scripts/jp-vocab-fill-example-sentences-ai.py）
# 与 jp-review-sync.env 共用 JP_REVIEW_UPLOAD_TOKEN
# OPENAI_API_KEY 可放 ~/.config/info-quests/jp-vocab-fill-example-sentences.env 或本机 .env.local

# 每次最多 AI 生成几条（避免一次跑太久）
JP_VOCAB_FILL_EXAMPLE_AI_LIMIT=15
# OpenAI 请求间隔（毫秒）
JP_VOCAB_FILL_EXAMPLE_AI_DELAY_MS=800
# 模型（默认 gpt-4o-mini）
# JP_VOCAB_FILL_EXAMPLE_AI_MODEL=gpt-4o-mini

# OPENAI_API_KEY=sk-...
