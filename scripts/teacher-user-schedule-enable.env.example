# Mac 端：北京时间 05:00 自动启用今日有课的老师账号
# 复制到 ~/.config/info-quests/teacher-user-schedule-enable.env
#
# 安装 launchd：
#   bash scripts/setup-teacher-user-schedule-enable-mac.sh
#
# 试跑（不写库）：
#   python3 scripts/teacher-user-schedule-enable-api.py --dry-run
#
# Bearer Token 使用 jp-review-sync.env 里的 JP_REVIEW_UPLOAD_TOKEN
TEACHER_USER_SCHEDULE_ENABLE_URL=https://finance.info-quests.com/api/admin/teacher-user-schedule-enable
TEACHER_USER_SCHEDULE_ENABLE_PYTHON=python3
