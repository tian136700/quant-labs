# 日程 → 网易邮箱 CalDAV → iPhone 日历
# 复制到 ~/.config/info-quests/schedule-caldav.env 后填写「留空」项
#
# 安装（venv + launchd，默认每 30 分钟同步一次）:
#   bash scripts/setup-schedule-caldav-mac.sh
#
# 试跑（不写网易日历）:
#   scripts/.venv-schedule-caldav/bin/python3 scripts/schedule-caldav-sync.py --dry-run
#
# 立即同步:
#   bash scripts/schedule-caldav-sync.sh
#
# Bearer Token 复用 jp-review-sync.env 里的 JP_REVIEW_UPLOAD_TOKEN

# ---------- 网上可查到的网易个人邮箱 CalDAV（已填好，一般不用改）----------
# 个人邮箱：163 / 126 / yeah.net；企业邮请改成 caldav.qiye.163.com 或 caldavhz.qiye.163.com
SCHEDULE_CALDAV_URL=https://caldav.163.com/
# HTTPS CalDAV 端口（标准 443）
SCHEDULE_CALDAV_PORT=443

# ---------- 需要你填写（留空）----------
# 网易邮箱完整地址，例如 xxx@163.com
SCHEDULE_CALDAV_EMAIL=
# 网页邮箱「设置 → POP3/SMTP/IMAP」拿到的客户端授权码（不是登录密码）
SCHEDULE_CALDAV_PASSWORD=
# 若账号下有多个日历，可填日历显示名精确匹配；留空则用第一个可写日历
SCHEDULE_CALDAV_CALENDAR_NAME=

# ---------- 网站日程导出 API ----------
SCHEDULE_EVENTS_API_URL=https://finance.info-quests.com/api/admin/schedule-events
SCHEDULE_CALDAV_PYTHON=
