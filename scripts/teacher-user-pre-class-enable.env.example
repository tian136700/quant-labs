# Mac 端：开课前 2 小时内自动启用已禁用的老师账号（每 10 分钟）
# 复制到 ~/.config/info-quests/teacher-user-pre-class-enable.env
#
# 安装 launchd：
#   bash scripts/setup-teacher-user-pre-class-enable-mac.sh
#
# 试跑（不写库）：
#   python3 scripts/teacher-user-pre-class-enable-api.py --dry-run
#
# Bearer Token 使用 jp-review-sync.env 里的 JP_REVIEW_UPLOAD_TOKEN
TEACHER_USER_PRE_CLASS_ENABLE_URL=https://finance.info-quests.com/api/admin/teacher-user-pre-class-enable
TEACHER_USER_PRE_CLASS_ENABLE_PYTHON=python3
# 目录锁过期秒数（默认 600=10 分钟，与调度间隔一致；防止上一轮卡住永久 skip）
# TEACHER_USER_PRE_CLASS_ENABLE_LOCK_STALE_SECONDS=600
