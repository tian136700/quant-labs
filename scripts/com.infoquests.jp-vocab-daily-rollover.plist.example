<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.infoquests.jp-vocab-daily-rollover</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/jp-vocab-daily-rollover-nightly.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>__INTERVAL__</integer>
  <key>ThrottleInterval</key>
  <integer>__INTERVAL__</integer>
  <key>StandardOutPath</key>
  <string>/Users/Admin/Library/Logs/jp-vocab-daily-rollover.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Admin/Library/Logs/jp-vocab-daily-rollover.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
