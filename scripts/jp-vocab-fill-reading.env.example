# Mac 端日语单词读音按分钟补全（复制到 ~/.config/info-quests/jp-vocab-fill-reading.env）
#
# 安装定时任务：
#   bash scripts/setup-jp-vocab-fill-reading-mac.sh
#
# 手动试跑（不写库）：
#   python3 scripts/jp-vocab-fill-reading-api.py --dry-run
#
# 手动指定某个词条读音：
#   python3 scripts/jp-vocab-fill-reading-api.py --update 123:かな
#
# Bearer Token 直接用 jp-review-sync.env 里的 JP_REVIEW_UPLOAD_TOKEN（日语教案上传那串）
# 无需在此重复配置；见 ~/.config/info-quests/jp-review-sync.env
# API 地址（默认线上 Worker）
JP_VOCAB_FILL_READING_URL=https://finance.info-quests.com/api/jp-vocab/fill-reading
# 跨日清理 API（释放批次、共享、协助请求等；与 fill-reading 由 jp-vocab-nightly.sh 统一调度）
JP_VOCAB_DAILY_ROLLOVER_URL=https://finance.info-quests.com/api/jp-vocab/daily-rollover
# 定时任务使用的 Python（建议填写带 certifi 的 venv python）
# 例如：/Users/<you>/Documents/code/us_stock_monitor/.venv/bin/python3
JP_VOCAB_FILL_READING_PYTHON=python3
# 是否用 Jisho 词典 API 补汉字词读音（1=开，0=关；在 Mac 本地查 Jisho，再通过 API 写库）
JP_VOCAB_FILL_READING_JISHO=1
# Jisho 请求间隔（毫秒），Mac 本地执行，避免限流
JP_VOCAB_FILL_READING_JISHO_DELAY_MS=350
# launchd 执行间隔（秒）：默认 600=每 10 分钟；合盖再开盖会补跑欠的一轮（不会把欠的次数全打一遍）
JP_VOCAB_FILL_READING_INTERVAL_SECONDS=600
# 读音补全很轻（list_missing + Mac 本地 Jisho + apply），默认全天可跑。
# 静默窗口：START==END 时等于不静默。例句/释义 Ollama 任务仍各自静默，勿混用。
JP_VOCAB_FILL_QUIET_START_HOUR=24
JP_VOCAB_FILL_QUIET_END_HOUR=24
JP_VOCAB_FILL_TZ=Asia/Shanghai
# 残留锁超时（秒）：持有者进程已死，或锁目录存活超过该时间，则自动回收后重跑（默认 15 分钟≈1.5×间隔）
# 上一轮未结束 → dirlock skip（绝不并行）；禁止去掉 dirlock 去「赶进度」
JP_VOCAB_FILL_READING_LOCK_STALE_SECONDS=900
# last_success 超过该秒数未更新时在日志打 WARNING（默认 2 小时）
JP_VOCAB_FILL_READING_SUCCESS_STALE_SECONDS=7200
