# Mac 端日语单词读音 nightly 补全（复制到 ~/.config/info-quests/jp-vocab-fill-reading.env）
#
# 安装定时任务：
#   bash scripts/setup-jp-vocab-fill-reading-mac.sh
#
# 手动试跑（不写库）：
#   bash scripts/jp-vocab-fill-reading-nightly.sh
#   python3 scripts/migrate-jp-vocab-fill-reading.py --remote --jisho --dry-run
#
# 目标库：remote=线上 D1（默认），local=本机 wrangler 本地 D1
JP_VOCAB_FILL_READING_TARGET=remote
# 是否用 Jisho 词典 API 补汉字词读音（1=开，0=关）
JP_VOCAB_FILL_READING_JISHO=1
# Jisho 请求间隔（秒），避免限流
JP_VOCAB_FILL_READING_JISHO_DELAY=0.35
# launchd 每天执行时间（24 小时制，默认 22:00）
JP_VOCAB_FILL_READING_HOUR=22
JP_VOCAB_FILL_READING_MINUTE=0
