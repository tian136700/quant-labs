# Mac 端日语复习 PDF 同步配置（复制到 ~/.config/info-quests/jp-review-sync.env）
#
# 依赖安装（Mac 勿用系统 pip，会报 externally-managed-environment）：
#   bash scripts/setup-jp-review-mac.sh
#
# JP_REVIEW_UPLOAD_TOKEN=wrangler secret put JP_REVIEW_UPLOAD_TOKEN 时设的那串
# 同一 Token 还用于：POST /api/jp-vocab/upload、POST /api/jp-vocab/fill-reading（假名 nightly）
# JP_REVIEW_UPLOAD_URL=https://finance.info-quests.com/api/jp-review/upload
# JP_REVIEW_FOLDER=/Users/Admin/Library/CloudStorage/坚果云-493701289@qq.com/我的坚果云/学习/日语口语
# JP_REVIEW_TAG_INDICES=6,7
