# 日语词条 Ollama 补全（词性 / 释义 / 例句 分阶段）
# 复制到 ~/.config/info-quests/jp-vocab-fill.env

# 每阶段单次只拉 1 条（生成后立即 apply）；**禁止改大**
JP_VOCAB_FILL_POS_AI_LIMIT=1
JP_VOCAB_FILL_MEANING_AI_LIMIT=1
JP_VOCAB_FILL_EXAMPLE_AI_LIMIT=1
JP_VOCAB_FILL_MAX_WORDS_PER_RUN=1

# 主模型 + 兜底链（单模型墙钟 600s）
JP_VOCAB_FILL_OLLAMA_MODEL=gemma4:26b
JP_VOCAB_FILL_OLLAMA_FALLBACK_MODEL=qwen2.5:14b,qwen2.5:7b
JP_VOCAB_FILL_OLLAMA_TIMEOUT_SEC=600

# Ollama 槽忙则 skip（下一分钟再试），勿干等占 dirlock
JP_VOCAB_FILL_OLLAMA_SLOT_WAIT_SEC=0

# STT 项目路径（默认 ~/Documents/code/wq-code/stt）
# JP_VOCAB_FILL_STT_ROOT=/path/to/stt
