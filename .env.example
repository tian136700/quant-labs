# 生产站点根 URL（用于 canonical、sitemap、Open Graph）
NEXT_PUBLIC_SITE_URL=https://finance.info-quests.com

# 外卖平台独立子域名（打开根路径 / 即为外卖评价页）
# 本地测试：/etc/hosts 加 127.0.0.1 food.local，然后设为 food.local
NEXT_PUBLIC_STORE_REVIEW_HOST=food.info-quests.com
NEXT_PUBLIC_STORE_REVIEW_SITE_URL=https://food.info-quests.com

# AI Trend Digest 博客独立子域名
# 线上：已在 wrangler.toml 配 blog.info-quests.com，git push + npm run deploy 即可
# 本地直连（无需子域名）：http://127.0.0.1:3002/trend-blog
# 本地子域名模拟（可选）：/etc/hosts 加 127.0.0.1 blog.local，下面两行写入 .env.local
# NEXT_PUBLIC_TREND_BLOG_HOST=blog.local
# NEXT_PUBLIC_TREND_BLOG_SITE_URL=http://blog.local:3002

# 在线工具：本地 http://127.0.0.1:3002/zh/tool-dot（与 english-teacher-review 一样走路径）

# 日语模块独立子域名（方案 A：仅绑域名，与 finance 同一 Worker，无路径 rewrite）
# 分享链接示例：https://japanese.info-quests.com/jp-lesson
# 已在 wrangler.toml 配 japanese.info-quests.com，deploy 后 Cloudflare 自动绑 Custom Domain

# 登录 Cookie 跨子域名共享（finance / food / japanese 等）
ETR_COOKIE_DOMAIN=.info-quests.com

# Google Search Console 验证（HTML 标签方式，只填 content 里的那串字符，不要整段 HTML）
# finance / food / blog 子域名可各配一个；blog 静态页也可在 trend_aggregator/web/index.html 加 meta
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FOOD_GOOGLE_SITE_VERIFICATION=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# BLOG_GOOGLE_SITE_VERIFICATION=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz

# 英语老师评价：管理员账号（密码只放 .env.local，勿提交 Git）
# 本地开发：复制到 .env.local 并填入真实密码
# 线上部署：wrangler secret put ETR_ADMIN_PASSWORD
ETR_ADMIN_USERNAME=Admin
ETR_ADMIN_PASSWORD=

# 日语单词模块：李老师专用账号（用户名默认 LiLaoshi，密码只放 .env.local）
# 线上：wrangler secret put ETR_JP_VOCAB_PASSWORD
ETR_JP_VOCAB_USERNAME=LiLaoshi
ETR_JP_VOCAB_PASSWORD=

# 日语单词模块：user1（与李老师同权限；密码仅 .env.local / wrangler secret，至少 10 位，勿写进 Git）
# 本地：在 .env.local 设置 ETR_JP_VOCAB_USER1_PASSWORD=你的强密码
# 线上：wrangler secret put ETR_JP_VOCAB_USER1_PASSWORD
ETR_JP_VOCAB_USER1_USERNAME=user1
ETR_JP_VOCAB_USER1_PASSWORD=

# 日语口语复习 PDF + 日语单词列表上传（共用同一 Bearer Token）
# Mac scripts/jp-review-sync.py 上传 PDF；POST /api/jp-vocab/upload 上传单词
# POST /api/trends/ingest 趋势入库；POST /api/trend-blog/publish 博客手动发布
# 线上：wrangler secret put JP_REVIEW_UPLOAD_TOKEN
# JP_REVIEW_UPLOAD_TOKEN=
# 可选：下载需 ?key= 时填写（老师 bookmark 带 key 的 /jp-review 链接）
# JP_REVIEW_DOWNLOAD_KEY=

# trend_aggregator 入库（pipeline --sync-db / scripts/import-trends-json.py）
# 本地默认 POST http://127.0.0.1:3002/api/trends/ingest；Bearer 与 JP_REVIEW_UPLOAD_TOKEN 共用
# TREND_INGEST_URL=http://127.0.0.1:3002/api/trends/ingest
