<view class="flashcard-page" wx:if="{{word}}">
  <view class="safe-top"></view>

  <view class="banner">已复习 {{cumulativeCount}} 个单词</view>

  <view class="card-header">
    <view class="card-header__top">
      <view class="tags">
        <text class="tag tag-kind">{{kindLabel}}</text>
        <text wx:if="{{dailySeq}}" class="tag">序号 {{dailySeq}}</text>
        <text wx:if="{{reviewed}}" class="tag tag-done">已复习</text>
        <text class="tag tag-progress">{{progressLabel}}</text>
      </view>
      <view class="close-btn" bindtap="onClose">×</view>
    </view>
    <view class="session-progress">
      <view class="session-progress__head">
        <text>本轮复习进度</text>
        <text class="session-progress__stats">{{sessionReviewed}} / {{sessionTotal}}</text>
      </view>
      <view class="progress-bar">
        <view class="progress-bar__fill" style="width: {{sessionPct}}%;"></view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="card-body" enhanced show-scrollbar="{{false}}">
    <view class="hero">
      <text wx:if="{{word.reading}}" class="hero__reading">{{word.reading}}</text>
      <text class="hero__word">{{word.word}}</text>
    </view>

    <view class="meta-block">
      <view class="meta-row">
        <text class="meta-label">释义</text>
        <text class="meta-value">{{word.meaning || '—'}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">词性</text>
        <text class="meta-value">{{word.pos || '—'}}</text>
      </view>
      <view wx:if="{{!word.reading}}" class="meta-row">
        <text class="meta-label">读音</text>
        <text class="meta-value muted">待补全</text>
      </view>
    </view>

    <view wx:if="{{word.mnemonic}}" class="mnemonic">
      <text class="mnemonic__label">巧记</text>
      <text class="mnemonic__body">{{word.mnemonic}}</text>
    </view>
    <text wx:else class="muted mnemonic-empty">巧记：暂未填写</text>

    <view class="level-block">
      <text class="block-title">当前熟悉程度</text>
      <view class="level-list">
        <view
          wx:for="{{levels}}"
          wx:key="key"
          class="level-item {{selectedLevel === item.key ? 'level-item--checked' : ''}}"
        >
          <text class="level-check">{{selectedLevel === item.key ? '✓' : ''}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="stats">
      <view class="stat">
        <text class="stat__label">抽查优先级</text>
        <text class="stat__value stat__value--{{riskTier}}">{{risk}}</text>
      </view>
      <view class="stat">
        <text class="stat__label">今日抽查</text>
        <text class="stat__value">{{todayChecks}}</text>
      </view>
      <view class="stat">
        <text class="stat__label">复习合计</text>
        <text class="stat__value">{{totalLabel}}</text>
      </view>
      <view class="stat-grid">
        <text class="stat-weak">不熟悉 {{word.cntWeak}}</text>
        <text>一般 {{word.cntNormal}}</text>
        <text class="stat-very">非常熟悉 {{word.cntVery}}</text>
      </view>
    </view>

    <view wx:if="{{hasNotes}}" class="notes">
      <view class="notes__head">
        <text class="block-title">备注</text>
        <text class="notes__view" bindtap="onViewNotes">查看全文</text>
      </view>
      <text wx:if="{{showNotesPreview}}" class="notes__preview">{{notesText}}</text>
      <text wx:else class="muted">备注较长，请点「查看全文」</text>
    </view>
  </scroll-view>

  <view class="nav-bar">
    <button
      class="nav-btn nav-btn--prev"
      disabled="{{!canGoPrev || recording}}"
      bindtap="onPrev"
    >
      上一个
    </button>
    <button
      class="nav-btn nav-btn--next"
      loading="{{recording}}"
      disabled="{{recording}}"
      bindtap="onNext"
    >
      {{isLast ? '完成复习' : '下一个'}}
    </button>
  </view>
  <view class="nav-hint muted" wx:if="{{!isLast && !recording}}">点击「下一个」计入复习进度</view>
  <view class="safe-bottom"></view>
</view>
