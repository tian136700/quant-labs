.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.center {
  text-align: center;
  padding: 80rpx 0;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}

.logout {
  color: #e85d6f;
  padding: 8rpx 16rpx;
}

.status {
  display: block;
  color: #e85d6f;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.config {
  margin-bottom: 28rpx;
}

.config-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.label {
  font-weight: 600;
  min-width: 140rpx;
}

.count-input {
  width: 140rpx;
  height: 72rpx;
  padding: 0 20rpx;
  background: #12141a;
  border: 2rpx solid #2e3440;
  border-radius: 12rpx;
  color: #e8eaed;
}

.hint {
  font-size: 24rpx;
}

.sort-group {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.sort-opt {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.summary {
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.clear-progress {
  margin-bottom: 20rpx;
}

.clear-progress .muted {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
}

.list-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.list-title {
  font-weight: 700;
  font-size: 30rpx;
}

.word-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-card {
  background: #1a1d24;
  border: 2rpx solid #2e3440;
  border-radius: 20rpx;
  padding: 24rpx;
}

.word-card--done {
  opacity: 0.75;
}

.word-card__main {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.word-card__seq {
  flex-shrink: 0;
  color: #9aa0a6;
  font-size: 24rpx;
  min-width: 56rpx;
}

.word-card__body {
  flex: 1;
  min-width: 0;
}

.word-card__word {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.word-card__reading {
  display: block;
  color: #9aa0a6;
  font-size: 24rpx;
}

.word-card__meaning {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
}

.word-card__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.word-card__status {
  flex-shrink: 0;
}

.start-one-btn {
  width: 100%;
  margin-top: 16rpx;
  min-height: 72rpx;
  font-size: 26rpx;
}

.empty {
  padding: 48rpx 0;
}
