.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 48rpx;
}

.hero__title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero__sub {
  display: block;
  color: #9aa0a6;
  font-size: 26rpx;
}

.form .input {
  width: 100%;
  height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #12141a;
  border: 2rpx solid #2e3440;
  border-radius: 16rpx;
  color: #e8eaed;
}

.error {
  display: block;
  color: #e85d6f;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.login-btn {
  width: 100%;
  margin-top: 8rpx;
}
