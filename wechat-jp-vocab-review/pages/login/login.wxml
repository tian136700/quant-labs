<view class="page">
  <view class="hero">
    <text class="hero__title">日语复习</text>
    <text class="hero__sub">管理员登录后使用，与网页端复习进度同步</text>
  </view>

  <view class="panel form">
    <input
      class="input"
      placeholder="用户名"
      value="{{username}}"
      bindinput="onUsernameInput"
      confirm-type="next"
    />
    <input
      class="input"
      password
      placeholder="密码"
      value="{{password}}"
      bindinput="onPasswordInput"
      confirm-type="done"
      bindconfirm="onLogin"
    />
    <text wx:if="{{error}}" class="error">{{error}}</text>
    <button class="btn btn-primary login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">
      登录
    </button>
  </view>
</view>
